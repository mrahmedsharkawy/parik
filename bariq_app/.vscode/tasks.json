{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bariq: Flutter Web Preview",
      "type": "shell",
      "command": "flutter",
      "args": ["run", "-d", "chrome", "--web-port", "5500"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Bariq: Build Web Release",
      "type": "shell",
      "command": "flutter",
      "args": ["build", "web", "--release"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
