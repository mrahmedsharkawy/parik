{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/assets/icon-96.png" },
    { "source": "/favicon.png", "destination": "/assets/icon-96.png" },
    { "source": "/assets/favicon.svg", "destination": "/assets/icon-96.png" },
    { "source": "/assets/categories/sticker/:file", "destination": "/assets/categories/Sticker/:file" },
    { "source": "/assets/categories/ramadan/:file", "destination": "/assets/categories/Ramadan/:file" },
    { "source": "/assets/categories/forex/:file", "destination": "/assets/categories/Forex/:file" },
    { "source": "/affiliate-program", "destination": "/affiliate.html" },
    { "source": "/affiliate-program.html", "destination": "/affiliate.html" },
    { "source": "/categories/:path*", "destination": "/categories.html" },
    { "source": "/policy/:slug", "destination": "/policy.html" },
    { "source": "/product/:id/:slug", "destination": "/product.html" },
    { "source": "/product/:id",       "destination": "/product.html" },
    { "source": "/product", "destination": "/product.html" },
    { "source": "/categories", "destination": "/categories.html" },
    { "source": "/Cart", "destination": "/Cart.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/offers", "destination": "/offers.html" },
    { "source": "/monthly-offers", "destination": "/monthly-offers.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/policy", "destination": "/policy.html" },
    { "source": "/affiliate", "destination": "/affiliate.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin-reports", "destination": "/admin-reports.html" },
    { "source": "/sales-invoices", "destination": "/sales-invoices.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/categories",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/categories/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/product",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/product/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/Cart",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/account",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/login",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/offers",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/checkout",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/affiliate",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/admin-reports",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/admin-reports-manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/policy",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/policy/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/:path*.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/style/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }]
    },
    {
      "source": "/java/Products.min.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/java/Cart.min.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/java/Products.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/java/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }]
    },
    {
      "source": "/java/supabase.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/java/supabase.min.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/java/main.min.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/java/instant-nav.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/java/sw-refresh.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/java/push-welcome.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/mobile-nav-bar/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/translations/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }]
    }
  ]
}
